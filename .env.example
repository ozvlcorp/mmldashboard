# ────────────────────────────────────────────────────────────────────
# OY Dashboard AI — переменные окружения
#
# Для локального запуска:  скопируй в .env, поправь значения
# Для Dokploy:               добавь каждую переменную в Environment Variables
#                            проекта (Settings → Environment)
# ────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────
POSTGRES_USER=oysuite
POSTGRES_PASSWORD=changeme_to_strong_random
POSTGRES_DB=oysuite

# ── Backend (FastAPI) ───────────────────────────────────────────────
# DATABASE_URL собирается из POSTGRES_* выше, переопределять не нужно
# если ты не подключаешь внешнюю Postgres.

# Защита admin-эндпоинтов. Сгенерируй: openssl rand -hex 32
ADMIN_SECRET=

# Через какие домены разрешать CORS-запросы. Production: точные URL.
CORS_ORIGINS=*

# ── JWT (Phase 2+) ──────────────────────────────────────────────────
# Для подписи session-токенов виджета. openssl rand -hex 32
# JWT_SIGNING_KEY=

# ── МойСклад Vendor API (Phase 2+) ──────────────────────────────────
# Получить в кабинете разработчика МойСклад → Приложение → Настройки.
# MS_VENDOR_APP_UID=oy.mml
# MS_VENDOR_SECRET=

# ── Anthropic (для AI-консультанта) ─────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxx

# ── Frontend ────────────────────────────────────────────────────────
# Публичный URL backend, виджет дёргает его из браузера.
# Локально: http://localhost:8000
# Production: https://api.oymoysklad.com
BACKEND_PUBLIC_URL=http://localhost:8000
